#!/bin/bash
# Reconnect the USB Wi-Fi dongle (wlan1) if it is not connected.
# Called by the NM dispatcher and a 20-second timer.
# The onboard radio (wlan0) runs as a permanent AP and is not touched here.
set -u
exec 9>/run/picar-wifi.lock
flock -n 9 || exit 0

wifi_dev() {
    local d bus
    for d in /sys/class/net/*; do
        [ -d "$d/wireless" ] || [ -d "$d/phy80211" ] || continue
        bus=$(basename "$(readlink -f "$d/device/subsystem" 2>/dev/null)")
        [ "$bus" = "usb" ] && basename "$d" && return
    done
}

state() { nmcli -g GENERAL.STATE device show "$1" 2>/dev/null | cut -d' ' -f1; }

dongle=$(wifi_dev)
[ -n "$dongle" ] || exit 0

case "$(state "$dongle")" in
    100|40|50|60|70|80|90) ;;
    *) nmcli device connect "$dongle" 2>/dev/null || true ;;
esac
